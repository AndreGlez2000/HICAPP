{
  "expo": {
    "name": "HiC",
    "slug": "hic-native",
    "scheme": "hic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#522C45"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.hospitalinfantil.hic"
    },
    "android": {
      "package": "mx.hospitalinfantil.hic",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#522C45"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router"
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "HiC necesita acceso a tu cámara para registrar tus fotos de comida y actividad."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#522c45",
          "androidMode": "default"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d79c7f6c-13a6-4d3b-bd16-ed191c57d5bb"
      }
    }
  }
}
